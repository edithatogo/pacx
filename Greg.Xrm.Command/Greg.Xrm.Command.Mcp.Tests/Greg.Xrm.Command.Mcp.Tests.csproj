<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Greg.Xrm.Command.Mcp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Greg.Xrm.Command.Mcp\Greg.Xrm.Command.Mcp.csproj" />
  </ItemGroup>

  <Target Name="CopyTestHostRuntimeConfig" AfterTargets="Build">
    <Copy
      SourceFiles="$(TargetDir)$(AssemblyName).runtimeconfig.json"
      DestinationFiles="$(TargetDir)testhost.runtimeconfig.json"
      SkipUnchangedFiles="true"
      Condition="Exists('$(TargetDir)$(AssemblyName).runtimeconfig.json')" />
    <Delete Files="$(TargetDir)testhost.exe;$(TargetDir)testhost.x86.exe" />
  </Target>

</Project>
